# Backend Environment Variables
# Copy this to .env and fill in your values

# JWT
JWT_SECRET=generate_a_long_random_string_here

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://claudefo.com/auth/discord/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://claudefo.com/auth/google/callback

# Facebook OAuth (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://claudefo.com/auth/facebook/callback

# Apple OAuth (optional)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_REDIRECT_URI=https://claudefo.com/auth/apple/callback

# Telegram OAuth (optional)
TELEGRAM_BOT_TOKEN=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
FRONTEND_URL=https://claudefo.com

# Resend (email engine)
RESEND_API_KEY=re_xxx
FROM_EMAIL=Claude.FO <noreply@claudefo.com>

# Cron job security
CRON_SECRET=generate_a_random_token_here
